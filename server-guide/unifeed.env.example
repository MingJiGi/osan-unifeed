# /etc/unifeed/unifeed.env 로 복사해서 바꿀 값만 채운다 (sudo chmod 600)
# 환경변수가 application.properties 보다 우선한다. 비워 둔 줄은 지운다(빈 값으로 덮어쓰지 않게).
# ⚠️ 이 예시 파일에는 진짜 비밀번호를 적지 않는다

# SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/toydb?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Seoul&characterEncoding=UTF-8
# SPRING_DATASOURCE_USERNAME=toy
# SPRING_DATASOURCE_PASSWORD=
